{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "build",
  "headers": [
    {
      "source": "/openapi.yaml",
      "headers": [
        { "key": "Content-Type", "value": "application/yaml" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/api/openapi.yaml",
      "headers": [
        { "key": "Content-Type", "value": "application/yaml" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
