{
  "name": "@mcclowes/fpl-api-spec",
  "version": "1.1.0",
  "description": "Unofficial OpenAPI specification for the Fantasy Premier League API",
  "files": [
    "static/openapi.yaml"
  ],
  "exports": {
    ".": "./static/openapi.yaml",
    "./openapi.yaml": "./static/openapi.yaml"
  },
  "scripts": {
    "dev": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "build:spec": "node scripts/build-spec.mjs api.omg.md static/openapi.yaml",
    "lint": "omg lint endpoints/",
    "lint:spec": "speccy lint static/openapi.yaml",
    "diff:spec": "speccy diff origin/main:static/openapi.yaml static/openapi.yaml",
    "check:package": "npm pack --dry-run",
    "generate:sdk": "npm --prefix sdk run generate",
    "build:sdk": "npm --prefix sdk run build",
    "check:sdk": "npm --prefix sdk run check"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "omg-md-cli": "^0.1.0",
    "speccy-cli": "^0.12.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mdx-js/react": "^3.0.0",
    "@vercel/analytics": "^2.0.1",
    "docusaurus-plugin-speccy": "^0.12.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "_comment_overrides": "ajv 8.18+ generates code that Docusaurus's jiti module loader mis-parses, so loading the Speccy plugin (which pulls in Spectral) throws at config time. Pin Spectral's ajv until jiti handles it.",
  "overrides": {
    "@stoplight/spectral-core": { "ajv": "8.17.1" },
    "@stoplight/spectral-functions": { "ajv": "8.17.1" },
    "@stoplight/spectral-rulesets": { "ajv": "8.17.1" }
  },
  "keywords": [
    "fpl",
    "fantasy-premier-league",
    "api",
    "openapi",
    "documentation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcclowes/fpl-oas.git"
  },
  "homepage": "https://github.com/mcclowes/fpl-oas#readme",
  "bugs": {
    "url": "https://github.com/mcclowes/fpl-oas/issues"
  },
  "engines": {
    "node": ">=20.0"
  }
}
